{
  "name": "@jayobado/kiln",
  "version": "0.3.0",

  "exports": {
    ".": "./mod.ts",

    "./auth": "./auth/mod.ts",
    "./upstream": "./upstream/mod.ts",
    "./procedure": "./procedure/mod.ts",
    "./route": "./route/mod.ts",
    "./rpc": "./rpc/mod.ts",
    "./health": "./health/mod.ts",
    "./shutdown": "./shutdown/mod.ts",

    "./client": "./client/mod.ts",
    "./client/dsl": "./client/dsl/mod.ts",
    "./client/query": "./client/query/mod.ts",
    "./client/primitives": "./client/primitives/mod.ts",
    "./client/hooks": "./client/hooks/mod.ts",
    "./client/rpc": "./rpc/client.ts"
  },

  "imports": {
    "@std/http": "jsr:@std/http@^1.0.0",
    "@deno/emit": "jsr:@deno/emit@^0.46.0",
    "@std/path": "jsr:@std/path@^1",
    "@standard-schema/spec": "npm:@standard-schema/spec@^1.0.0",
    "@std/assert": "jsr:@std/assert@^1"
  },

  "publish": {
    "exclude": ["**/*_test.ts", "**/*.test.ts"]
  },

  "tasks": {
    "check": "deno check mod.ts auth/mod.ts upstream/mod.ts procedure/mod.ts route/mod.ts rpc/mod.ts health/mod.ts shutdown/mod.ts client/mod.ts client/dsl/mod.ts client/query/mod.ts client/primitives/mod.ts client/hooks/mod.ts rpc/client.ts",
    "test": "deno test --allow-net",
    "update": "deno cache --reload --lock=deno.lock mod.ts"
  },

  "compilerOptions": {
    "strict": true,
    "lib": ["ESNext", "DOM", "Deno.NS"]
  }
}
